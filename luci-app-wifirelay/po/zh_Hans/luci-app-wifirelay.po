msgid "WiFi Relay"
msgstr "WiFi 中继"

msgid "Relay Configuration"
msgstr "中继配置"

msgid "Relay status"
msgstr "中继状态"

msgid "Online"
msgstr "在线"

msgid "Connecting"
msgstr "连接中"

msgid "Degraded"
msgstr "已降级"

msgid "Failed"
msgstr "失败"

msgid "Disabled"
msgstr "已停用"

msgid "Stopped"
msgstr "已停止"

msgid "Unknown"
msgstr "未知"

msgid "Uplink"
msgstr "上行"

msgid "Health check: ping www.baidu.com every 30 seconds, 3 second timeout, failover after 3 consecutive failures."
msgstr "健康检查：每 30 秒 ping 一次 www.baidu.com，单次超时 3 秒，连续失败 3 次后切换。"

msgid "Reapply configuration"
msgstr "重新应用配置"

msgid "Applying relay configuration. Watch the status above for the result."
msgstr "正在应用中继配置，请留意上方状态查看结果。"

msgid "Failed to start applying. Is the relay backend service running?"
msgstr "启动应用失败，请确认中继后端服务是否正在运行。"

msgid "Configure cross-band WiFi relay in router mode with NAT."
msgstr "在路由模式（NAT）下配置跨频段 WiFi 中继。"

msgid "Relay settings"
msgstr "中继设置"

msgid "Enable relay service"
msgstr "启用中继服务"

msgid "Uplink band"
msgstr "上行频段"

msgid "2.4 GHz receives, 5 GHz transmits"
msgstr "2.4 GHz 接收，5 GHz 发射"

msgid "5 GHz receives, 2.4 GHz transmits"
msgstr "5 GHz 接收，2.4 GHz 发射"

msgid "Downstream AP settings"
msgstr "下游 AP 设置"

msgid "Each band has independent SSID, password and security settings. LAN stays 192.168.1.1/24 with NAT."
msgstr "每个频段均可独立设置 SSID、密码和加密方式。LAN 保持 192.168.1.1/24 并启用 NAT。"

msgid "Band"
msgstr "频段"

msgid "SSID"
msgstr "SSID"

msgid "Password"
msgstr "密码"

msgid "Security"
msgstr "加密方式"

msgid "WPA2-PSK/WPA3-SAE Mixed Mode"
msgstr "WPA2-PSK/WPA3-SAE 混合模式"

msgid "WPA2-PSK/WPA3-SAE"
msgstr "WPA2-PSK/WPA3-SAE"

msgid "WPA2-PSK/WPA3-SAE mixed"
msgstr "WPA2-PSK/WPA3-SAE 混合模式"

msgid "WPA-PSK/WPA2-PSK Mixed Mode"
msgstr "WPA-PSK/WPA2-PSK 混合模式"

msgid "WPA-PSK/WPA2-PSK"
msgstr "WPA-PSK/WPA2-PSK"

msgid "WPA-PSK/WPA2-PSK mixed"
msgstr "WPA-PSK/WPA2-PSK 混合模式"

msgid "WPA3-SAE"
msgstr "WPA3-SAE"

msgid "WPA2-PSK"
msgstr "WPA2-PSK"

msgid "WPA-PSK"
msgstr "WPA-PSK"

msgid "WEP"
msgstr "WEP"

msgid "Open network (no password)"
msgstr "开放网络（无密码）"

msgid "Open network"
msgstr "开放网络"

msgid "Choosing \"Open network (no password)\" hides the password field; this AP will be unencrypted."
msgstr "选择“开放网络（无密码）”将隐藏密码输入框，该 AP 将不加密。"

msgid "Saved upstream WiFi"
msgstr "已保存的上级 WiFi"

msgid "Sorted by signal strength for automatic selection. Hidden SSIDs and same-name network management are not supported; use BSSID to pin a specific AP."
msgstr "按信号强度排序用于自动选择。不支持隐藏 SSID 与同名网络管理；如需固定连接指定 AP，请填写 BSSID。"

msgid "BSSID"
msgstr "BSSID"

msgid "BSSID (optional)"
msgstr "BSSID（可选）"

msgid "For open networks no password is required."
msgstr "开放网络无需填写密码。"

msgid "Signal"
msgstr "信号"

msgid "Signal (dBm)"
msgstr "信号（dBm）"

msgid "%d dBm"
msgstr "%d dBm"

msgid "5 GHz"
msgstr "5 GHz"

msgid "2.4 GHz"
msgstr "2.4 GHz"

msgid "Updated automatically on each scan; drives the automatic ordering."
msgstr "每次扫描后自动更新，用于决定自动选择顺序。"

msgid "Enabled"
msgstr "已启用"

msgid "Action"
msgstr "操作"

msgid "Activate"
msgstr "激活"

msgid "Profile \"%s\" marked active. Use Save & Apply to connect."
msgstr "已将配置“%s”设为当前使用，点击“保存并应用”后连接。"

msgid "Scan upstream WiFi"
msgstr "扫描上级 WiFi"

msgid "Scan 2.4 GHz"
msgstr "扫描 2.4 GHz"

msgid "Scan 5 GHz"
msgstr "扫描 5 GHz"

msgid "2.4 GHz scan results"
msgstr "2.4 GHz 扫描结果"

msgid "5 GHz scan results"
msgstr "5 GHz 扫描结果"

msgid "No networks found"
msgstr "未发现任何网络"

msgid "Use"
msgstr "使用"

msgid "Network \"%s\" added to the saved list. Enter its password below and use Save & Apply."
msgstr "网络“%s”已加入已保存列表，请在下方填写其密码并点击“保存并应用”。"

msgid "Close"
msgstr "关闭"

msgid "The scan failed. Make sure the wireless interfaces are up."
msgstr "扫描失败，请确认无线接口已启用。"

msgid "<hidden>"
msgstr "（隐藏）"
