config relay 'global'
	option enabled '0'
	option lan_ip '192.168.1.1'
	option lan_netmask '255.255.255.0'
	option check_interval '30'
	option ping_timeout '3'
	option failure_limit '3'
	option ping_host 'www.baidu.com'
	option uplink_band '5g'
	option active_uplink ''

config ap 'ap_2g'
	option band '2g'
	option device 'MT7981_1_1'
	option phy 'ra0'
	option iface 'apcli0'
	option section 'default_MT7981_1_1'
	option ssid ''
	option encryption 'psk2+sae'
	option key ''
	option network 'lan'

config ap 'ap_5g'
	option band '5g'
	option device 'MT7981_1_2'
	option phy 'rax0'
	option iface 'apclix0'
	option section 'default_MT7981_1_2'
	option ssid ''
	option encryption 'psk2+sae'
	option key ''
	option network 'lan'

config uplink 'uplink_2g'
	option band '2g'
	option device 'MT7981_1_1'
	option phy 'ra0'
	option iface 'apcli0'
	option ssid ''
	option bssid ''
	option encryption 'psk2'
	option key ''
	option network 'wwan'
	option enabled '1'

config uplink 'uplink_5g'
	option band '5g'
	option device 'MT7981_1_2'
	option phy 'rax0'
	option iface 'apclix0'
	option ssid ''
	option bssid ''
	option encryption 'psk2'
	option key ''
	option network 'wwan'
	option enabled '1'
