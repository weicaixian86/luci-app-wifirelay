#!/bin/sh /etc/rc.common

START=95
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/wifirelay monitor
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

# Applying a profile rewrites the wireless config, scans candidates and waits
# for connectivity, so keep reloads fire-and-forget: the monitor loop reports
# progress through /var/run/wifirelay.state and the LuCI status poll.
#
# No procd_add_reload_trigger here on purpose: applying a profile commits the
# wireless and wifirelay configs, which would turn a reload trigger into an
# endless apply loop.
reload_service() {
	( /usr/sbin/wifirelay apply >/dev/null 2>&1 ) &
}
